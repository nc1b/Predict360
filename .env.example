# Server-side secret for the optional AI explanation feature (Hack Club AI proxy).
# Copy to a local .env (gitignored) for local dev; set it in Vercel for production.
# Never prefix this with VITE_ and never put it in the web/ folder: it must stay
# server-side and must not reach the browser bundle.
HACKCLUB_AI_KEY=sk-hc-v1-xxxxxxxx
