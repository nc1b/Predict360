{
  "name": "predict360-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Opt-in daily activity tracking with website account sync.",
  "main": "main.js",
  "scripts": {
    "prestart": "node ../scripts/prepare-desktop.js",
    "start": "electron .",
    "predist": "node ../scripts/prepare-desktop.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "predist:mac": "node ../scripts/prepare-desktop.js",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.predict360.desktop",
    "productName": "Predict 360",
    "protocols": [
      {
        "name": "Predict 360 sign-in",
        "schemes": [
          "predict360"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "activity.js",
      "store.js",
      "renderer.js",
      "styles.css",
      "index.html",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Predict360-${version}-Windows.exe"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.healthcare-fitness",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Predict360-macOS.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  }
}
